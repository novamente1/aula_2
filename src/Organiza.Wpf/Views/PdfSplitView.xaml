<UserControl x:Class="Organiza.Wpf.Views.PdfSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <DockPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Dividir PDFs grandes" Style="{StaticResource Heading}" />
            <TextBlock Text="A divisão mede os bytes reais do PDF gerado. O original íntegro vai para 99 ORIGINAIS." Opacity="0.72" />
            <Border Background="#FFF6DC" CornerRadius="6" Padding="12" Margin="0,16,0,14">
                <TextBlock Text="Limite por parte: aproximadamente 97 MiB. Uma página indivisível maior é aceita sozinha. Nenhuma pasta temporária por hash é criada." TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding Status}" Margin="0,0,0,12" />
        </StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="Dividir PDFs marcados" Command="{Binding SplitCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
            <ListBox ItemsSource="{Binding Files}" BorderThickness="0" Background="Transparent"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </DockPanel>
        <Border Panel.ZIndex="20" Background="#D9F5F7FA"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#B9CCF5" BorderThickness="1" CornerRadius="10"
                    Padding="28" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processando... Aguarde a conclusão da etapa" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding OperationStatus}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="10" />
                    <TextBlock Text="Não feche o aplicativo nem mova o PDF enquanto esta janela estiver visível."
                               TextWrapping="Wrap" TextAlignment="Center" Opacity="0.68" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
