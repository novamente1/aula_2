<UserControl x:Class="Organiza.Wpf.Views.FolderSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
    <StackPanel Margin="0,0,10,18"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
        <TextBlock Text="Selecionar pasta" Style="{StaticResource Heading}" />
        <TextBlock Text="Cole um link de pasta do Google Drive ou escolha o caminho local sincronizado. Na primeira utilização do link, associe-o uma vez à pasta correspondente no Google Drive (G:)." Opacity="0.72" Margin="0,0,0,26" TextWrapping="Wrap" />
        <Border Background="White" CornerRadius="8" Padding="24">
            <StackPanel>
                <TextBlock Text="Caminho da pasta" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Padding="10" FontSize="14" />
                    <Button Grid.Column="1" Content="Explorar..." Command="{Binding BrowseCommand}" Margin="10,0,0,0" />
                </Grid>
                <CheckBox Content="Incluir subpastas na análise" IsChecked="{Binding IncludeSubfolders}" Margin="0,20,0,0" />
                <TextBlock Text="Como deseja trabalhar nesta pasta?" FontWeight="SemiBold" Margin="0,22,0,8" />
                <RadioButton Content="Apenas organizar/renomear arquivos internos (opção segura recomendada)"
                             IsChecked="{Binding OrganizeFilesOnly}" Margin="0,4" />
                <RadioButton Content="Criar/completar o modelo de imóvel (10 módulos, incluindo 07A)"
                             IsChecked="{Binding ApplyStandardStructure}" Margin="0,4" />
                <TextBlock Text="O modelo de imóvel só deve ser usado dentro de um imóvel de 04 REGULARIZANDO, 05 VENDA ou 06 ATIVO. Outros perfis serão reconhecidos e protegidos automaticamente."
                           Foreground="#8A5A00" Margin="0,6,0,0" TextWrapping="Wrap" />
                <TextBlock Text="A pasta raiz selecionada nunca será renomeada. Nomes de arquivos serão encurtados com segurança quando necessário; nenhum destino poderá ultrapassar 240 caracteres." Foreground="#227447" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                <Button Content="Confirmar pasta" Command="{Binding ConfirmCommand}" HorizontalAlignment="Left" Margin="0,22,0,0"
                        Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
            </StackPanel>
        </Border>
        <Border CornerRadius="6" Padding="14" Margin="0,18,0,0" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#EAF1FF" />
                    <Setter Property="BorderBrush" Value="#B9CCF5" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                            <Setter Property="Background" Value="#E7F6EC" />
                            <Setter Property="BorderBrush" Value="#78B98F" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="18" FontWeight="Bold" Foreground="#227447" Margin="0,0,10,0"
                           Visibility="{Binding IsConfirmed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="#C8D1DF" BorderThickness="1" CornerRadius="6"
                Padding="14" Margin="0,12,0,0"
                Visibility="{Binding HasAudit, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="Diagnóstico da estrutura oficial" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StructureSummary}" Margin="0,5,0,10" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Somente leitura: nada abaixo foi criado, renomeado, movido ou excluído."
                           Foreground="#227447" TextWrapping="Wrap" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding StructureItems}" AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" MaxHeight="300" Background="White" GridLinesVisibility="Horizontal"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Estrutura esperada" Binding="{Binding ExpectedName}" Width="190" />
                        <DataGridTextColumn Header="Estado oficial" Binding="{Binding State}" Width="115" />
                        <DataGridTextColumn Header="Situação" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Encontrada" Binding="{Binding FoundName}" Width="170" />
                        <DataGridTextColumn Header="Regra / divergência" Binding="{Binding Details}" Width="*" />
                        <DataGridTextColumn Header="Ação possível" Binding="{Binding PossibleAction}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Background="#F4F7FC" BorderBrush="#B9CCF5" BorderThickness="1" CornerRadius="6"
                        Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Ação estrutural opcional — exige confirmação" FontWeight="SemiBold" />
                        <TextBlock Text="O diagnóstico acima nunca altera a pasta. Use esta ação somente numa cópia de teste ou quando quiser criar as pastas ausentes do modelo correto."
                                   TextWrapping="Wrap" Margin="0,4,0,8" />
                        <ComboBox ItemsSource="{Binding CompatibleTemplates}" SelectedItem="{Binding SelectedTemplate}"
                                  DisplayMemberPath="DisplayName" MinWidth="320" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding SelectedTemplate.Explanation}" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <Button Content="Criar somente as pastas ausentes (confirmar)" Command="{Binding ApplyTemplateCommand}"
                                HorizontalAlignment="Left" Background="#8A5A00" Foreground="White" BorderThickness="0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="Auditoria automática de conformidade" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AuditSummary}" Margin="0,5,0,10" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding AuditDetails}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </StackPanel>
    </ScrollViewer>
        <Border Panel.ZIndex="20" Background="#D9F5F7FA"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White" BorderBrush="#78B98F" BorderThickness="1" CornerRadius="10"
                    Padding="28" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Processando... Aguarde a conclusão da etapa" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding ProgressStatus}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <ProgressBar IsIndeterminate="True" Height="10" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
